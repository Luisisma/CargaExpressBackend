# ==============================================================================
# CARGAEXPRESS BACKEND - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# Entorno: development | staging | production
ENVIRONMENT=development
DEBUG=True

# Configuración del Proyecto
PROJECT_NAME="CargaExpress API"
API_V1_STR=/api/v1
VERSION=1.0.0

# Base de Datos PostgreSQL
# Formato: postgresql+psycopg://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cargaexpress

# Seguridad Criptográfica y JWT (Mínimo 64 caracteres en producción)
SECRET_KEY=cambiar-esta-clave-secreta-por-una-de-alta-entropia-minimo-64-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TEMP_TOKEN_EXPIRE_MINUTES=5

# CORS - Orígenes permitidos (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Notificaciones por Correo Electrónico Real (Gmail SMTP / STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=abcd_efgh_ijkl_mnop
SMTP_FROM_NAME="CargaExpress Perú"
SMTP_FROM_EMAIL=tu_correo@gmail.com
EMAIL_ENABLED=true

# Fallback Sandbox (Mailtrap)
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=4950980
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=15

